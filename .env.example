# development 默认复用当前用户的 Copilot CLI 登录状态。
# production 建议使用 GITHUB_TOKEN，并使用独立 COPILOT_BASE_DIRECTORY。
PORT=3001
CORS_ORIGIN=http://localhost:5173
# GITHUB_TOKEN=

# ---------------------------------------------------------------
# Model policy
#
# 三个档位：
#
#   Strong   = Lead 复杂规划 / 综合 / 恢复
#   Standard = 普通 Lead + 普通 Member
#   Cheap    = 简单 Member Task
#
# 硬约束：
#
#   Strong Lead > Standard Lead >= 所有 Member model
#
# Lead 不固定使用 Strong：
#   - 普通用户输入 / 进度问题 -> Standard Lead
#   - 首次规划 / 澄清回复 / 阻塞恢复 / 整体重新判断 -> Strong Lead
#
# COPILOT_LEAD_MODEL 是旧配置名，仍兼容；
# 新配置优先使用 COPILOT_LEAD_STRONG_MODEL。
# ---------------------------------------------------------------
COPILOT_MODEL=gpt-5-mini
COPILOT_LEAD_STRONG_MODEL=gpt-5
COPILOT_LEAD_STANDARD_MODEL=gpt-5-mini
# 第一个 = 默认 Member 模型
COPILOT_MEMBER_MODELS=gpt-5-mini,gpt-4.1-mini
# 数字越大越强
COPILOT_MODEL_STRENGTHS={"gpt-5":100,"gpt-5-mini":60,"gpt-4.1-mini":40}

COPILOT_WARMUP=true

# 本地数据目录（sqlite + member home + workspace）
DATA_DIR=.data
#
# Copilot SDK 的 session state / compaction checkpoint 根目录。
#
# development:
#   不设置。npm run dev 会直接使用当前用户的 ~/.copilot，
#   从而复用本机 copilot CLI 的登录状态。
#
# production:
#   使用独立目录保存 Copilot session state / credentials。
#   默认 <DATA_DIR>/copilot。
#   **容器里必须指到挂载的持久卷**：Infinite Session 的压缩 checkpoint 落在这里，
#   放临时层的话每次重启都从零开始 —— resume 失败会静默回落到「新建 session」，
#   看起来没坏，实际上历史全丢了。
# 刻意和 Member 的 workspace 分开：那是 Agent 的工作目录（它的产物），这是 SDK 的
# 会话状态。混在一起的话，清一次 workspace 会连带把会话历史删掉。
# COPILOT_BASE_DIRECTORY=
# 无认证体系时的占位用户；接入 Entra ID / AD / OIDC 后只换请求上下文
LOCAL_USER_ID=local-user

# Member → Member 委派的最大深度
MAX_DELEGATION_DEPTH=4
# 单次 Member turn 的等待上限（毫秒）
EXECUTION_TIMEOUT_MS=600000
#
# 长期 Copilot session（每个 conversation+member 一个）的空闲回收时间（秒）。
# 到期被回收不是故障：下一轮会重建 session 并从 DB 恢复上下文。
# 独立分析（independentContext）与 delegation 用的 isolated session 不受它影响
# —— 那种 session 跑完就被删掉。
COPILOT_SESSION_IDLE_TIMEOUT_SECONDS=1800

# 启动时做一次崩溃恢复：
#   running / waiting_for_member → interrupted（不自动重跑，避免重复执行）
#   从未跑过的 root execution    → 重新提交
# 单进程独占 DB 才安全；多副本部署前必须改成 DB lease
RECOVER_ON_STARTUP=true

# 注入 prompt 的 shared message 上限（从最新往前取，至少 1 条）。
# 窗口是按大小截的：保留最新 —— 唤醒这个 Member 的是刚刚发生的事。
# 被截掉的部分会在 transcript 前显式说明省略了多少条，否则模型会把
# transcript 当成房间的全部，给出「截断本身制造出来的结论」。
#
# 这只是 Member 这一轮的**输入之一**：它自己的 Copilot Session 已经带着自己的
# 历史（由 SDK 自动 compact），Goal / Task status / Approval 是结构化事实单独
# 注入，Member / Team Memory 负责跨会话的长期记忆。所以这个窗口只需要承载
# 「最近一段房间动态」，不必把整个房间灌进来 —— 灌太多既和 Session 里已有的
# 历史重复计费，也会把这一轮真正要处理的消息挤到 prompt 底部。
MAX_CONTEXT_MESSAGES=60
MAX_CONTEXT_CHARS=32000

# ── Copilot Session 的上下文压缩（Infinite Session）─────────────────
#
# 不自己实现摘要 / 压缩，交给 Copilot SDK：
#   到 background 阈值 → 后台异步压缩，当前这一轮不受影响；
#   到 buffer 阈值     → 阻塞压缩，否则下一轮没地方放。
# 两个值都是「占模型上下文窗口的比例」，必须 background < buffer，
# 否则后台压缩还没机会跑就先撞上阻塞线。默认即 SDK 官方默认值。
#
# 压缩的是「Member 自己的 Agent 工作上下文」，不是 conversation_message
# （那是永久原始记录，不动），也不是 Member / Team Memory（跨会话的长期记忆）。
# COPILOT_COMPACTION_BACKGROUND_THRESHOLD=0.80
# COPILOT_COMPACTION_BUFFER_THRESHOLD=0.95

# 会话文件（聊天里的附件）。
#
# 它是第四种文件语义：ACL = 这个会话的成员（conversation_member），与知识库的
# capability binding 无关。上传**不会**自动进知识库 —— 要长期复用必须显式 promote
# （需要 owner/admin，因为那是一次发布）。
#
# 正文落在 <CONVERSATION_FILE_ROOT>/<conversationId>/files/<fileId>/original.<ext>，
# DB 里存相对路径，所以整个 DATA_DIR 可以搬家。刻意不放进 member home：文件属于
# 会话，不属于任何一个人。
#
# 单文件上限按「raw body 会被一次性读进内存」定：50MB 是这台机器能同时接住几个
# 上传的上限，不是「文件多了会怎样」的问题。要做到 GB 级得换成流式落盘 + 边写边
# 算 hash，那时这个值也该跟着改实现。
#
# MAX_EXTRACTED_TEXT_CHARS 是提取出的文本上限（超过截断）。它比知识库单份上限
# （1MB）更宽，所以超大文本在会话里搜得到、但存不进知识库 —— promote 会明确拒绝
# 并说清文件本身没丢。
# CONVERSATION_FILE_ROOT=     # 默认 <DATA_DIR>/conversations
MAX_CONVERSATION_FILE_BYTES=52428800
MAX_CONVERSATION_FILES_PER_MESSAGE=10
MAX_CONVERSATION_FILES_PER_CONVERSATION=500
MAX_EXTRACTED_TEXT_CHARS=500000

# 是否允许 Member 使用会触达宿主机的 built-in：bash / edit / grep / web_fetch
#
# 默认 false，且不随 Member 的能力绑定打开：绑定 runtime.host-coding-tools 是
# 「声明想要什么」，这个开关是「部署允不允许」。没有沙箱时 bash 能走到 workspace
# 之外，所以打开它等于承认当前 runtime 是可信的单租户环境。
HOST_CODING_TOOLS=false

# MCP Server 定义文件（`{"servers": [...]}`）。
#
# 缺省这个文件不存在也没关系：不接 MCP 也能跑，和「没配 Jira 就没有工单工具」
# 同一约定。token / secret 只放环境变量，JSON 里写 `${VAR}` 引用 ——
# 定义文件本身不落任何凭证，里面只有「怎么连 + 允许哪些工具」。
# 谁能用哪个 server 的哪些工具，是各层 capability binding 的事（Settings 里配）。
# MCP_SERVERS_FILE=config/mcp-servers.json

# 是否允许注册 local/stdio MCP Server：SDK 会在服务机器上为它启动子进程。
#
# 默认 false。远程（http / sse）不受影响，优先用远程。
# MCP_LOCAL_ENABLED=false

# Internal API（/api/internal）的共享 token —— 以某个 Member 的身份说话的入口。
#
# 留空 = 不校验（单机原型），启动日志会写明「Internal API 未设防」。
# 只要这个服务不是只跑在本机，就必须填。
# INTERNAL_API_TOKEN=

# Admin API（capabilities 写入 / knowledge 建库写文档 / skills 安装卸载 /
# 建 Member / 归档）的共享 token —— 改的是 Agent 的 capability boundary。
#
# 留空 = 不校验（单机原型），启动日志会写明「Admin API 未设防」。
# 只要这个服务不是只跑在本机，就必须填，否则任何调用方都能给 Member 开宿主能力。
# ADMIN_API_TOKEN=

# Team 业务模型 v1（单 Team 部署）。
#
# TEAM_NAME=AI Team 的默认名，启动时 ensure，不提供新建 Team 入口。
# LOCAL_ACTOR_ID=没有真正用户系统时 human actor 占位（接 Entra/OIDC 后替换 teamScope 解析）。
# SCHEDULER_INTERVAL_MS=Scheduler tick 间隔，只做 once + interval，不做 Calendar/RRULE。
# TEAM_NAME=AI Team
# LOCAL_ACTOR_ID=local-user
# SCHEDULER_INTERVAL_MS=2000

# Human 认证（OIDC/JWT）。不填 = 跟随 NODE_ENV（dev 默认开，production 默认关）。
# 开启时无 Bearer 回落 LOCAL_ACTOR_ID；显式 false 可在 dev 下用真实 OIDC 联调；
# production 显式 true 会被拒绝启动。Human API 要求调用方是 Team 的 active human 成员。
# AUTH_DEV_MODE=true
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URL=

# 默认 Member provisioning
#
# 模板目录是 provisioning baseline，不是运行时 source of truth：
# 只在「这个 Member 还没出现过」时读一次。已存在的（包括已归档、已改名、
# 已改过 system prompt 的）一律跳过，不会被覆盖。
#
# 模板里的 capabilities 只写 Provider ID（skill / knowledge / tool），所以
# 换掉某个后端实现时模板不用改。Provider ID 写错会让启动直接失败。
#
# 目录可以指向别处：ConfigMap / 只读 volume / 配置仓库。
# 设为 false 表示「代码带着模板，但不要自动建人」（接管已有数据的部署会想这么做）。
SEED_DEFAULT_MEMBERS=true
MEMBER_TEMPLATES_DIR=config/member-templates

# Team 级 Skill 与 Knowledge Base 目录（都在 DATA_DIR 下，一般不需要动）。
#
# team/skills：team.filesystem-skills 这个 Provider 的根目录，所有绑定它的
# Member 都会加载。Member 个人的 skill 在 members/<id>/skills/。
#
# team/knowledge/<key>/：目录即 team KB（key = 目录名），文件落进去即被
# local.filesystem-knowledge 索引。Member 个人资料在 members/<id>/knowledge/。
# 磁盘删除的文件不会自动从索引移除 —— 用 API 删，或重建数据目录。
# TEAM_SKILL_ROOT / TEAM_KNOWLEDGE_ROOT 不单独提供环境变量，随 DATA_DIR 走。

# ── 外部工作系统（可选，当前接 Jira）────────────────────────
# 三项都填才注册 Jira 工具（jira_search / jira_get_issue / jira_add_comment /
# jira_transition_issue）。业务工作以 Jira 为准：本地只存**引用**
# （provider / externalId / key / url），不存标题、状态、负责人。
# 三项没齐时控制面走「无外部工作上下文」路径 —— 不取证，也不假装有。
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@your-site.com
# JIRA_API_TOKEN=

# Jira webhook 的共享密钥（Jira 侧 webhook 配置里填同一个值）。
# 空 = 端点无门禁，只应在本机运行 —— 这个端点会触发本地广播，
# 无门禁时任何能访问服务的人都能伪造「这条工单变了」。
# JIRA_WEBHOOK_SECRET=
#
# 接 Jira 的 webhook 指向：POST /api/work-management/jira/webhook
# 事件类型选 issue 相关即可。本地只做最小投影（哪些房间挂了这条工单 → 发一条
# 「变了哪些字段」的事件），**不缓存工单内容**，UI 收到后自己去 Jira 读。
