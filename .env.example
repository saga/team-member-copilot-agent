# 复制后按需填写（留空则用 copilot CLI 已登录用户）
PORT=3001
CORS_ORIGIN=http://localhost:5173
# GITHUB_TOKEN=
COPILOT_MODEL=gpt-5
COPILOT_WARMUP=true

# 本地数据目录（sqlite + member home + workspace + copilot session state）
DATA_DIR=.data
# 无认证体系时的占位用户；接入 Entra ID / AD / OIDC 后只换请求上下文
LOCAL_USER_ID=local-user

# Member → Member 委派的最大深度
MAX_DELEGATION_DEPTH=4
# 单次 Member turn 的等待上限（毫秒）
EXECUTION_TIMEOUT_MS=600000
