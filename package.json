{
  "name": "team-member-copilot-agent",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "description": "Copilot SDK + Vite + TypeScript + Express 基础框架（参考 ai-interview-questions 的前后端同源结构）",
  "scripts": {
    "dev": "concurrently -n client,server -c green,blue \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "NODE_ENV=production node dist-server/index.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test server/test/*.test.ts",
    "smoke:boot": "node scripts/smoke-boot.mjs"
  },
  "dependencies": {
    "@ant-design/x": "^2.9.0",
    "@ant-design/x-markdown": "2.9.0",
    "@github/copilot-sdk": "^1.0.15",
    "antd": "^6.6.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
